{
  "name": "he-thong-quan-ly-nha-xe",
  "version": "1.0.0",
  "description": "Smart Bus Management System - Monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/*"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace=backend",
    "customer:dev": "npm start --workspace=frontend/customer-app",
    "admin:dev": "npm start --workspace=frontend/admin-dashboard",
    "docker:db:up": "docker-compose up -d mysql mongodb redis rabbitmq",
    "docker:db:down": "docker-compose down",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  }
}
